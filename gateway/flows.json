  {
    "id": "permacool-build-request",
    "type": "function",
    "z": "permacool-telemetry-tab",
    "name": "Validate and build telemetry request",
    "func": "const token = env.get('TELEMETRY_INGEST_TOKEN');\nif (!token) {\n    node.error('TELEMETRY_INGEST_TOKEN is required', msg);\n    return null;\n}\n\nconst values = msg.permacoolValues || {};\nconst definitions = [\n    ['ch1_temperature_c', '°C'],\n    ['ch1_setpoint_c', '°C'],\n    ['ch1_high_pressure', 'psi'],\n    ['ch1_low_pressure', 'psi'],\n    ['ch1_chiller_run', 'bool'],\n    ['ch1_system_on', 'bool'],\n    ['ch1_high_pressure_stop', 'bool'],\n    ['ch1_compressor_runtime_min', 'min'],\n    ['ch2_temperature_c', '°C'],\n    ['ch2_setpoint_c', '°C'],\n    ['ch2_high_pressure', 'psi'],\n    ['ch2_low_pressure', 'psi'],\n    ['ch2_chiller_run', 'bool'],\n    ['ch2_system_on', 'bool'],\n    ['ch2_high_pressure_stop', 'bool'],\n    ['ch2_compressor_runtime_min', 'min']\n];\n\nconst points = definitions\n    .map(([key, unit]) => ({ key, value: Number(values[key]), unit }))\n    .filter((point) => Number.isFinite(point.value));\n\nif (points.length !== definitions.length) {\n    node.error(`Expected ${definitions.length} numeric PAC values but received ${points.length}; telemetry was not sent`, msg);\n    return null;\n}\n\nmsg.method = 'POST';\nmsg.url = 'https://perma.cool/api/ingest/telemetry';\nmsg.headers = {\n    'content-type': 'application/json',\n    'x-telemetry-token': token\n};\nmsg.payload = {\n    gatewayId: env.get('PERMACOOL_GATEWAY_ID') || 'groov-epic-01',\n    siteId: env.get('PERMACOOL_SITE_ID') || 'site-salinas',\n    deviceId: env.get('PERMACOOL_DEVICE_ID') || 'epic-mvp-01',\n    capturedAt: new Date().toISOString(),\n    points\n};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1210,
    "y": 420,
    "wires": [
